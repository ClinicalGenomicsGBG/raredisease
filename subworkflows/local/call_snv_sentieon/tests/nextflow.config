process {

    withName: 'SENTIEON_DNASCOPE' {
        ext.prefix = { "${meta.id}_dnascope" }
    }

    withName: 'SENTIEON_DNAMODELAPPLY' {
        ext.prefix = { "${meta.id}_dnamodelapply.g" }
    }

    withName: 'ML_RESCUE_HET' {
        ext.args   = "--output-type z --write-index=tbi"
        ext.args2  = { "-i 'GT=\"RR\" && N_ALT=2 && FMT/ML[0:0]<=${params.ml_prob_threshold} && FMT/ML[0:1]>=FMT/ML[0:2]'" }
        ext.prefix = { "${meta.id}_mlrescue_het.g" }
    }

    withName: 'ML_RESCUE_HOMALT' {
        ext.args   = "--output-type z --write-index=tbi"
        ext.args2  = { "-i 'GT=\"RR\" && N_ALT=2 && FMT/ML[0:0]<=${params.ml_prob_threshold} && FMT/ML[0:2]>FMT/ML[0:1]'" }
        ext.prefix = { "${meta.id}_mlrescue.g" }
    }

    withName: 'SENTIEON_GVCFTYPER' {
        ext.args = { "--annotation ML,PL" }
        ext.prefix = { "${meta.id}_gvcftyper" }
    }

    withName: 'BCF_FILTER_ONE' {
        ext.args = { "-s 'ML_FAIL' -i 'INFO/ML_PROB <= ${params.ml_prob_threshold}' -m x --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}_mlfiltered" }
    }

    withName: 'BCF_FILTER_TWO' {
        ext.args   = "-i FILTER='\"PASS\"' -m x --output-type z --write-index=tbi"
        ext.prefix = { "${meta.id}_passed" }
    }

    withName: 'SPLIT_MULTIALLELICS_SEN' {
        ext.args   = {
            [
                '--output-type z',
                params.normalize_multiallelics ? '--multiallelics -both' : ''
            ].join(' ')
        }
        ext.prefix = { "${meta.id}_split" }
    }

    withName: 'REMOVE_DUPLICATES_SEN' {
        ext.args   = '--output-type z --rm-dup none --write-index=tbi'
        ext.prefix = { "${meta.id}_split_rmdup" }
    }

    withName: 'ADD_VARCALLER_TO_BED' {
        ext.args2  = '-s 1 -b 2 -e 3'
    }

    withName: 'BCFTOOLS_ANNOTATE' {
        ext.args   = '-c CHROM,FROM,TO,FOUND_IN --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}_split_rmdup_info" }
    }

}
