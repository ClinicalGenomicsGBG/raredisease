process {

    withName: '.*:CALL_SV_CANVAS:BEDTOOLS_SUBTRACT' {
        ext.prefix = { "${meta.id}_subtract" }
    }

    withName: '.*:CALL_SV_CANVAS:BEDTOOLS_COMPLEMENT' {
        ext.prefix = { "${meta.id}_filter" }
    }

    withName: '.*:CALL_SV_CANVAS:BCFTOOLS_REHEADER' {
        ext.prefix = { "${meta.id}_reheader" }
        ext.args = { "--samples-list '${meta.id}'" }
    }

    withName: '.*:CALL_SV_CANVAS:CANVAS_GERMLINE' {
        ext.prefix = { "${meta.id}_canvas"}
    }

    withName: '.*:CALL_SV_CANVAS:GAWK_CREATE_SEG' {
        ext.suffix = 'seg'
        ext.prefix = {"${meta.id}_germline_CNV"}
    }

    withName: '.*:CALL_SV_CANVAS:BCFTOOLS_NORM' {
        ext.prefix = { "${meta.id}_norm"}
        ext.args = {[
            '--check-ref s',
            '--do-not-normalize',
            '--output-type v'
        ].join(' ')}
    }

    withName: '.*:CALL_SV_CANVAS:GAWK_REFORMAT' {
        ext.suffix = 'vcf'
        ext.prefix = {"${meta.id}.formatted"}
        ext.args = { "-v expected_x_cn=${meta.sex}" }
    }

    withName: '.*:CALL_SV_CANVAS:BCFTOOLS_VIEW' {
        ext.args = {[
            '--output-type z',
            '--apply-filters PASS,q7,L10kb',
            '--exclude \'ID ~ "Canvas:REF"\'',
        ].join(' ')}
    }
}
